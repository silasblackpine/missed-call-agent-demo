# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005550100
PUBLIC_BASE_URL=https://your-app.vercel.app
# Optional: ring this number first; leave blank to always text back.
# The forwarded leg is screened: only press 1 on that phone bridges the
# caller. Carrier voicemail cannot accept the call. Default timeout is 10s.
# Dial callerId is TWILIO_PHONE_NUMBER when that value is set. The whisper
# speaks the original caller's last four digits, or
# "Missed-call line. Press 1 to take it." when the number is missing or withheld.
FORWARD_TO_NUMBER=
DIAL_TIMEOUT_SECONDS=10
BUSINESS_NAME=Your Business
CALENDLY_URL=https://calendly.com/your-handle/intro

# Optional HubSpot hook
ENABLE_HUBSPOT=false
HUBSPOT_TOKEN=your_private_app_token
HUBSPOT_PIPELINE_ID=default
HUBSPOT_PIPELINE_STAGE_ID=your_first_stage_id

# Optional Resend hook
ENABLE_RESEND=false
RESEND_API_KEY=re_your_key
RESEND_FROM=Black Pine Lab <support@blackpinelab.com>
NOTIFY_EMAIL=you@example.com

# Durable storage (Postgres pooled URL, e.g. Supabase/Neon). Unset = in-memory.
DATABASE_URL=

# Local dev only - never enable in production
SKIP_TWILIO_VALIDATION=false

# Optional ElevenLabs (PR #7 option 1: after press-1 consent). Default off.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_6201m5xvvahmfm9ajahpbepqt8vx
ELEVENLABS_HANDOFF_ENABLED=false
ELEVENLABS_HANDOFF_ON_DECLINE=false
ELEVENLABS_TIMEOUT_SECONDS=10  # per register-call attempt; stay under Twilio 15s webhook limit

# Option 2 draft (not live): ring FORWARD_TO_NUMBER first (no Polly line),
# then on a miss /api/dial-status hands off silently to Pine. Default off.
# Deploying this branch does nothing until this flag is true.
ELEVENLABS_DIRECT_ANSWER=false
# Shared secret for POST /api/tools/send-text (header X-Tool-Secret). Fail closed if unset.
ELEVENLABS_TOOL_SECRET=
