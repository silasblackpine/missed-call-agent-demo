# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005550100
PUBLIC_BASE_URL=https://your-app.vercel.app
# Optional: ring this number first; leave blank to always text back
FORWARD_TO_NUMBER=
DIAL_TIMEOUT_SECONDS=20
BUSINESS_NAME=Your Business
CALENDLY_URL=https://calendly.com/your-handle/intro

# Optional HubSpot hook
ENABLE_HUBSPOT=false
HUBSPOT_TOKEN=your_private_app_token
HUBSPOT_PIPELINE_ID=default
HUBSPOT_PIPELINE_STAGE_ID=your_first_stage_id

# Optional Resend hook
ENABLE_RESEND=false
RESEND_API_KEY=re_your_key
RESEND_FROM=Black Pine Lab <support@blackpinelab.com>
NOTIFY_EMAIL=you@example.com

# Durable storage (Postgres pooled URL, e.g. Supabase/Neon). Unset = in-memory.
DATABASE_URL=

# Local dev only - never enable in production
SKIP_TWILIO_VALIDATION=false
